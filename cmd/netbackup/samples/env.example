# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to version control.
# File permissions should be restricted, e.g.: chmod 600 .env

# Default credentials (used when credential_group is omitted or set to 'default')
# Either NETBACKUP_PASSWORD or NETBACKUP_KEY_FILE (or both) can be used.
NETBACKUP_USERNAME=svc-netbackup
NETBACKUP_PASSWORD=change-me
# NETBACKUP_KEY_FILE=/home/netops/.ssh/id_ed25519

# Optional per-site or per-group credentials (matched against inventory credential_group)
# Password-based group:
# NETBACKUP_SITE_HCM_USERNAME=svc-hcm-backup
# NETBACKUP_SITE_HCM_PASSWORD=site-hcm-pass
# SSH key-based group:
# NETBACKUP_SITE_DC_USERNAME=svc-dc-backup
# NETBACKUP_SITE_DC_KEY_FILE=/home/netops/.ssh/id_rsa_dc

# Jump host / bastion support
# Global default bastion used when no per-device jump_host is set in inventory.
# Can also be overridden at runtime with: -jump-host, -jump-user, -jump-password, -jump-key-file
# NETBACKUP_JUMP_HOST=mgmt-gw.example.com:22
# NETBACKUP_JUMP_USERNAME=svc-jump
# NETBACKUP_JUMP_PASSWORD=jump-change-me
# NETBACKUP_JUMP_KEY_FILE=/home/netops/.ssh/jump_key

# Per-named-jump credentials (jump_host name from inventory CSV, uppercased).
# Allows different bastions for different network segments.
# NETBACKUP_JUMP_BASTION_DC_HOST=bastion-dc.example.com:22
# NETBACKUP_JUMP_BASTION_DC_USERNAME=svc-dc-jump
# NETBACKUP_JUMP_BASTION_DC_PASSWORD=dc-jump-pass
# NETBACKUP_JUMP_BASTION_DC_KEY_FILE=/home/netops/.ssh/dc_jump_key
# NETBACKUP_JUMP_BASTION_SITE_HCM_HOST=mgmt-gw.site-hcm.example.com:22
# NETBACKUP_JUMP_BASTION_SITE_HCM_USERNAME=svc-hcm-jump
# NETBACKUP_JUMP_BASTION_SITE_HCM_PASSWORD=hcm-jump-pass
# NETBACKUP_JUMP_BASTION_SITE_HCM_KEY_FILE=/home/netops/.ssh/hcm_jump_key
