#!/bin/sh
# ==============================================================================
# Script Name:   show-backup
# Description:   Universal cross-platform launcher for show-backup.
# Usage:         ./show-backup [options] <node-name>
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

case "$(uname -s 2>/dev/null)" in
    CYGWIN*|MINGW*|MSYS*)
        # Windows running under Git Bash / MSYS / Cygwin
        if [ -f "$SCRIPT_DIR/scripts/show-backup.bat" ] && ! command -v bash >/dev/null 2>&1; then
            exec cmd.exe /c "$SCRIPT_DIR/scripts/show-backup.bat" "$@"
        else
            exec /usr/bin/env bash "$SCRIPT_DIR/scripts/show-backup.sh" "$@"
        fi
        ;;
    *)
        exec /usr/bin/env bash "$SCRIPT_DIR/scripts/show-backup.sh" "$@"
        ;;
esac
