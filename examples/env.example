# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to version control.
# File permissions should be restricted, e.g.: chmod 600 .env

# Default credentials (used when credential_group is omitted or set to 'default')
NETBACKUP_USERNAME=svc-netbackup
NETBACKUP_PASSWORD=change-me

# Optional per-site or per-group credentials (matched against inventory credential_group)
# NETBACKUP_SITE_HCM_USERNAME=svc-hcm-backup
# NETBACKUP_SITE_HCM_PASSWORD=site-hcm-pass
# NETBACKUP_SITE_DC_USERNAME=svc-dc-backup
# NETBACKUP_SITE_DC_PASSWORD=site-dc-pass
